model Truck {
  id     Int               @id @default(autoincrement())
  plate  String            @unique
  model  String
  routes Route[]
  users  TruckAssignment[]
}

model TruckAssignment {
  userId  Int
  truckId Int
  truck   Truck @relation(fields: [truckId], references: [id])
  user    User  @relation(fields: [userId], references: [id])

  @@id([userId, truckId])
}

model Route {
  id      Int    @id @default(autoincrement())
  origin  String
  destiny String
  truckId Int
  truck   Truck  @relation(fields: [truckId], references: [id])
}

enum UserRole {
  CLIENT
  DRIVER
  ADMIN
}
