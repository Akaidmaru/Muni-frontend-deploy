# Desarrollo local: apunta al Nest en tu máquina
VITE_API_BASE_URL=http://localhost:3000
# Compat legado (dev): fallback si no se define VITE_API_BASE_URL.
VITE_OLD_ORIGIN=

# GitHub Actions: crea el secret VITE_API_BASE_URL con la URL pública del API (p. ej. https://api.tudominio.cl),
# igual que tfv_public_api_url en Ansible / output de Terraform. El workflow "Publish to GHCR" lo exige.
#
# App móvil (Capacitor): el mismo build usa esta URL para axios/socket. En el BACKEND, CORS_ORIGIN debe incluir
# los orígenes del SPA web (https://www...) y los de Capacitor (típicamente capacitor://localhost, a veces ionic://localhost).

VITE_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID de Google Cloud. En GitHub Actions: secret VITE_GOOGLE_MAPS_MAP_ID (si no, build usa DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
